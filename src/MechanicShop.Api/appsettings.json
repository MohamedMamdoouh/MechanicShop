{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SECOND; Database=MechanicShop; Trusted_Connection=True; TrustServerCertificate=True;"
  },

  "AllowedHosts": "*",

  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },

  "TokenSettings": {
    "FingerprintSalt": ""
  },

  "PerformanceSettings": {
    "LongRunningRequestThresholdInMs": 500
  },

  "DashboardSettings": {
    "DashboardHistoryLimitInMonths": 24
  },

  "AppSettings": {
    "OpeningTime": "08:00",
    "ClosingTime": "18:00",
    "MaxSpots": 4,
    "MinimumAppointmentDurationInMinutes": 30,
    "MaxAppointmentDurationInMinutes": 480,
    "LocalCacheExpirationInMinutes": 5,
    "DistributedCacheExpirationInMinutes": 30,
    "DefaultPageNumber": 1,
    "DefaultPageSize": 10,
    "BookingCancellationThresholdInMinutes": 60,
    "OverdueBookingCleanupFrequencyInMinutes": 15,
    "CorsPolicyName": "MechanicShopCorsPolicy",
    "CorsAllowedOrigins": ["https://localhost:7102", "https://localhost:5001"],
    "ShopName": "Mechanic Shop",
    "PhoneValidationRegion": "EG",
    "ShopTimeZone": "Africa/Cairo"
  },

  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {SourceContext} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },

  "OpenTelemetry": {
    "Endpoint": ""
  },

  "SendGridSettings": {
    "ApiKey": "",
    "FromEmail": "",
    "FromName": "",
    "TemplateId": ""
  }
}
