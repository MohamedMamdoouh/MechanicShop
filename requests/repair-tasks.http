### Get All Repair Tasks
GET {{baseUrl}}/repairtasks
Authorization: Bearer {{managerToken}}

### Get Repair Task By ID
GET {{baseUrl}}/repairtasks/{{repairTaskId}}
Authorization: Bearer {{managerToken}}

### Create Repair Task
POST {{baseUrl}}/repairtasks
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
    "name": "Spark Plug Replacement",
    "laborCost": 60.00,
    "repairDurationMinutes": 60,
    "parts": [
        {
            "name": "Spark Plug",
            "cost": 8.50,
            "quantity": 4
        }
    ]
}

### Update Repair Task
PUT {{baseUrl}}/repairtasks
Content-Type: application/json
Authorization: Bearer {{managerToken}}

{
    "repairTaskId": "{{repairTaskId}}",
    "name": "Spark Plug Replacement (Updated22)",
    "laborCost": 65.00,
    "repairDurationMinutes": 60,
    "parts": [
        {
            "partId": "{{partId}}",
            "name": "Spark Plug (Iridium)",
            "cost": 12.00,
            "quantity": 4
        }
    ]
}

### Delete Repair Task
DELETE {{baseUrl}}/repairtasks/{{repairTaskId}}
Authorization: Bearer {{managerToken}}
