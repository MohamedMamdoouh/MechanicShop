<Project>

  <!-- ─── All projects ─────────────────────────────────────────────── -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>

    <!-- Reproducible builds: same input → same binary hash -->
    <Deterministic>true</Deterministic>

    <!-- Suppress noisy rules that don't apply to this codebase -->
    <NoWarn>
      $(NoWarn);
      SA0001;SA1009;SA1010;SA1012;SA1101;SA1107;SA1111;SA1115;SA1116;SA1117;SA1118;
      SA1122;SA1127;SA1133;SA1200;SA1201;SA1202;SA1204;SA1208;SA1210;SA1303;SA1309;
      SA1312;SA1313;SA1316;SA1401;SA1402;SA1413;SA1501;SA1502;SA1503;SA1505;SA1508;
      SA1512;SA1513;SA1515;SA1516;SA1517;SA1518;SA1519;SA1600;SA1602;SA1604;SA1633;SA1649;
      CA1848;CA1861;CA1873;CA2007;CA2012;
    </NoWarn>
  </PropertyGroup>

  <!-- ─── Source projects only ───────────────────────────────────────── -->
  <PropertyGroup Condition="!$(MSBuildProjectFullPath.Replace('\', '/').Contains('/tests/'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ─── Test projects only ─────────────────────────────────────────── -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.Replace('\', '/').Contains('/tests/'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;xUnit1045</NoWarn>
  </PropertyGroup>

  <!-- ─── Analyzers (all projects) ───────────────────────────────────── -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
