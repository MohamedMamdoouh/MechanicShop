root = true

############################
# GENERAL SETTINGS
############################

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

############################
# C# FILES
############################

[*.cs]

#### LANGUAGE VERSION
dotnet_language_version = latest

#### NULLABILITY
dotnet_enable_nullable_reference_types = true

#### STYLE: var usage
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

#### BRACES
csharp_prefer_braces = true:warning

#### PREFER MODERN SYNTAX
csharp_style_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_local_over_anonymous_function = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion

#### EXPRESSION-BODIED MEMBERS
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion

#### STRING STYLE
csharp_style_prefer_interpolated_string = true:suggestion

#### USING DIRECTIVES
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

############################
# NAMING RULES
############################

dotnet_naming_rule.types_should_be_pascal_case.severity = warning
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

############################
# ANALYZERS (QUALITY)
############################

dotnet_analyzer_diagnostic.severity = warning

# Treat important correctness rules as errors
dotnet_diagnostic.CA2000.severity = error   # dispose objects
dotnet_diagnostic.CA2200.severity = error   # rethrow correctly
dotnet_diagnostic.CA2213.severity = error   # disposable fields
dotnet_diagnostic.CA1822.severity = suggestion

# Keep noisy ones relaxed
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1311.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1716.severity = none

############################
# TEST PROJECT OVERRIDES
############################

[*.Tests.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA1707.severity = none

# Keep formatting strict
dotnet_diagnostic.SA1010.severity = warning

# Allow modern C# style
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1117.severity = none
dotnet_diagnostic.SA1316.severity = warning

############################
# FILE ORGANIZATION (optional)
############################

[*.cs]
dotnet_sort_system_directives_first = true
file_header_template = unset
