{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch MechanicShop API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build MechanicShop API",
      "program": "${workspaceFolder}/src/MechanicShop.Api/bin/Debug/net9.0/MechanicShop.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/MechanicShop.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7102"
      },
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "Attach to MechanicShop API",
      "type": "coreclr",
      "request": "attach"
    },
    {
      "name": "Launch in integrated browser",
      "type": "editor-browser",
      "request": "launch",
      "url": "https://localhost:7102"
    }
  ],
  "compounds": [
    {
      "name": "Launch API + Integrated Browser",
      "configurations": [
        "Launch MechanicShop API",
        "Launch in integrated browser"
      ],
      "stopAll": true
    }
  ]
}
